							"if (pm.response.code === 200) {",
							"  const json = pm.response.json();",
							"  if (json && json.token) {",
							"    pm.environment.set('token', json.token);",
							"    console.log('token saved to environment.token');",
							"  }",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
